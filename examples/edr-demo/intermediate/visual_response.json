{
  "calculated_columns": [
    {
      "table": "dim_clients",
      "name": "Nom Complet Client",
      "expression": "dim_clients[Prenom] & \" \" & dim_clients[Nom]",
      "data_type": "string"
    },
    {
      "table": "dim_clients",
