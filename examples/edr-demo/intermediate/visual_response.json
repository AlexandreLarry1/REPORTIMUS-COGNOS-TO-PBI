      "data_type": "double"
    },
    {
      "table": "fact_positions",
      "name": "Signe PnL",
      "expression": "IF(fact_positions[PnL_EUR] >= 0, \"Positif\", \"Negatif\")",
      "data_type": "string"
    },
    {
      "table": "fact_performances",
      "name": "Vs Benchmark",
      "expression": "IF(fact_performances[Alpha_pct] >= 0, \"Surperforme\", \"Sous-performe\")",
      "data_type": "string"
    }
  ],
  "measures": [
    {
      "name": "Nb Clients",
      "table": "dim_clients",
      "expression": "DISTINCTCOUNT(dim_clients[ClientID])"
    },
    {
      "name": "AuM Moyen / Client (EUR)",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[ValeurMarche_EUR]) / DISTINCTCOUNT(dim_clients[ClientID])"
    },
    {
      "name": "Nb Portef. Moy. / Client",
      "table": "dim_portefeuilles",
      "expression": "DISTINCTCOUNT(dim_portefeuilles[PortefeuilleID]) / DISTINCTCOUNT(dim_clients[ClientID])"
    },
    {
      "name": "Anciennete Moy. (ans)",
      "table": "dim_clients",
      "expression": "AVERAGE(dim_clients[Anciennete (ans)])"
    },
    {
      "name": "Nb Tx Moy. / Client",
      "table": "fact_transactions",
      "expression": "DISTINCTCOUNT(fact_transactions[TransactionID]) / DISTINCTCOUNT(dim_clients[ClientID])"
    },
    {
      "name": "Revenus Totaux (EUR)",
      "table": "fact_transactions",
      "expression": "SUM(fact_transactions[MontantNet_EUR])"
    },
    {
      "name": "Count Distinct ClientID",
      "table": "dim_clients",
      "expression": "DISTINCTCOUNT(dim_clients[ClientID])"
    },
    {
      "name": "AuM",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[ValeurMarche_EUR])"
    },
    {
      "name": "Sum PnL (EUR)",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[PnL_EUR])"
    },
    {
      "name": "Count Distinct TransactionID",
      "table": "fact_transactions",
      "expression": "DISTINCTCOUNT(fact_transactions[TransactionID])"
    },
    {
      "name": "AuM Total (EUR)",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[ValeurMarche_EUR])"
    },
    {
      "name": "PnL Total (EUR)",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[PnL_EUR])"
    },
    {
      "name": "Nb Portefeuilles",
      "table": "dim_portefeuilles",
      "expression": "DISTINCTCOUNT(dim_portefeuilles[PortefeuilleID])"
    },
    {
      "name": "Rendement Moyen (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Rendement_pct])"
    },
    {
      "name": "Benchmark Moyen (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Benchmark_pct])"
    },
    {
      "name": "Ratio Sharpe Moyen",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[RatioSharpe])"
    },
    {
      "name": "Max Drawdown (%)",
      "table": "fact_performances",
      "expression": "MIN(fact_performances[MaxDrawdown_pct])"
    },
    {
      "name": "Sum Flux Nets (EUR)",
      "table": "fact_performances",
      "expression": "SUM(fact_performances[FluxNets_EUR])"
    },
    {
      "name": "Avg Rendement (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Rendement_pct])"
    },
    {
      "name": "Avg Benchmark (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Benchmark_pct])"
    },
    {
      "name": "Avg Alpha (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Alpha_pct])"
    },
    {
      "name": "Count PortefeuilleID",
