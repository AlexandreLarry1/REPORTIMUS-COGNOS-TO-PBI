  "measures": [
    {
      "name": "Nb Clients",
      "table": "dim_clients",
      "expression": "COUNTROWS(VALUES(dim_clients[ClientID]))"
    },
    {
      "name": "AuM Moyen / Client (EUR)",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[Valeur Marche (EUR)]) / COUNTROWS(VALUES(dim_clients[ClientID]))"
    },
    {
      "name": "Nb Portef. Moy. / Client",
      "table": "dim_portefeuilles",
      "expression": "COUNTROWS(VALUES(dim_portefeuilles[PortefeuilleID])) / COUNTROWS(VALUES(dim_clients[ClientID]))"
    },
    {
      "name": "Anciennete Moy. (ans)",
      "table": "dim_clients",
      "expression": "AVERAGE(dim_clients[Anciennete (ans)])"
    },
    {
      "name": "Nb Tx Moy. / Client",
      "table": "fact_transactions",
      "expression": "COUNTROWS(VALUES(fact_transactions[TransactionID])) / COUNTROWS(VALUES(dim_clients[ClientID]))"
    },
    {
      "name": "Revenus Totaux (EUR)",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[Revenus EUR])"
    },
    {
      "name": "Count ClientID",
      "table": "dim_clients",
      "expression": "COUNTROWS(VALUES(dim_clients[ClientID]))"
    },
    {
      "name": "Sum Valeur Marche EUR",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[Valeur Marche (EUR)])"
    },
    {
      "name": "Count TransactionID",
      "table": "fact_transactions",
      "expression": "COUNTROWS(VALUES(fact_transactions[TransactionID]))"
    },
    {
      "name": "Sum PnL EUR",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[PnL (EUR)])"
    },
    {
      "name": "Count PortefeuilleID",
      "table": "dim_portefeuilles",
      "expression": "COUNTROWS(VALUES(dim_portefeuilles[PortefeuilleID]))"
    },
    {
      "name": "Sum Valeur Achat EUR",
      "table": "fact_positions",
      "expression": "SUM(fact_positions[Valeur Achat (EUR)])"
    },
    {
      "name": "Sum Volume",
      "table": "fact_cours_historiques",
      "expression": "SUM(fact_cours_historiques[Volume])"
    },
    {
      "name": "Count InstrumentID",
      "table": "dim_instruments",
      "expression": "COUNTROWS(VALUES(dim_instruments[InstrumentID]))"
    },
    {
      "name": "Avg PnL (%)",
      "table": "fact_positions",
      "expression": "AVERAGE(fact_positions[PnL (%)])"
    },
    {
      "name": "Avg Rendement (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Rendement (%)])"
    },
    {
      "name": "Avg Benchmark (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Benchmark (%)])"
    },
    {
      "name": "Avg Alpha (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Alpha (%)])"
    },
    {
      "name": "Avg Volatilite (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Volatilite (%)])"
    },
    {
      "name": "Min Max Drawdown (%)",
      "table": "fact_performances",
      "expression": "MIN(fact_performances[Max Drawdown (%)])"
    },
    {
      "name": "Avg Ratio Sharpe",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Ratio Sharpe])"
    },
    {
      "name": "Avg Rendement Cumule (%)",
      "table": "fact_performances",
      "expression": "AVERAGE(fact_performances[Rendement Cumule (%)])"
    },
    {
      "name": "Sum Valeur Portefeuille EUR",
      "table": "fact_performances",
      "expression": "SUM(fact_performances[Valeur Portefeuille (EUR)])"
    },
    {
      "name": "Sum Flux Nets EUR",
      "table": "fact_performances",
      "expression": "SUM(fact_performances[Flux Nets (EUR)])"
    },
    {
      "name": "Nb Alertes",
      "table": "fact_alertes_risque",
      "expression": "COUNTROWS(VALUES(fact_alertes_risque[AlerteID]))"
    },
    {
      "name": "Alertes Critiques",
      "table": "fact_alertes_risque",
      "expression": "CALCULATE(COUNTROWS(VALUES(fact_alertes_risque[AlerteID])), fact_alertes_risque[Severite] = \"Critique\")"
    },
    {
      "name": "Count Statut Alerte",
      "table": "fact_alertes_risque",
      "expression": "COUNTROWS(VALUES(fact_alertes_risque[Statut Alerte]))"
    }
  ],
