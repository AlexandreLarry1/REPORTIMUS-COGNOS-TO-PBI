QLIK_WS_URL=ws://localhost:4848/app/
QLIK_QVF_NAME="My App.qvf"
EXAMPLE_NAME=asset-management

# Cognos pipeline defaults (overridden by --example / --xml CLI args)
COGNOS_EXAMPLE_NAME=cognos-demo-complex
COGNOS_XML_PATH=examples/cognos-demo-complex/assurance.xml

# --- Azure OpenAI (api mode) ---
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=<deployment-name>

# --- Langfuse tracing (set LANGFUSE_ENABLED=true to activate) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com